{
  "name": "nt-parser",
  "version": "0.1.0",
  "description": "Парсер списка ПВЗ (пунктов выдачи заказов) с сайта tvzgo.ru",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "generate:api": "openapi-ts",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "node --test",
    "dump": "npm run build && node scripts/save-output.mjs",
    "unenriched": "node scripts/show-unenriched.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "tvzgo",
    "пвз",
    "pickup",
    "parser",
    "доставка"
  ],
  "license": "MIT",
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^22.20.3",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.7",
    "typescript": "^5.5.0"
  }
}
